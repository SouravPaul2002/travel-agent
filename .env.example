# LLM Configuration (Required)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Places & Hotel APIs (Optional / Free Tier)
# If not provided, fallback mechanisms (OSM Overpass / OpenTripMap / DDG) will be used.
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# App Configuration
APP_ENV=development
CACHE_DB_PATH=travel_cache.db

# Tracing (Optional - Milestone 6)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=travel-planner-agent
